# Per-developer override for the API base URL.
# Defaults (in app.json -> extra.apiUrl): http://10.0.2.2:5000/api  (Android emulator → host machine)
#
# Choose based on how you run the app:
#   iOS simulator on the same Mac   → http://localhost:5000/api
#   Android emulator                → http://10.0.2.2:5000/api
#   Physical device on your WiFi    → http://<your-LAN-IP>:5000/api  (e.g. http://192.168.1.42:5000/api)
#   Production                      → https://your-render-domain.com/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
