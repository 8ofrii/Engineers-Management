// Global default office fee percentages per category
model GlobalCategoryFee {
  id                String              @id @default(uuid())
  category          TransactionCategory @unique
  defaultFeePercent Decimal             @db.Decimal(5, 2)
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("global_category_fees")
}

// Project-specific category fee overrides
model ProjectCategoryFee {
  id         String              @id @default(uuid())
  projectId  String
  category   TransactionCategory
  feePercent Decimal             @db.Decimal(5, 2)
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([projectId, category])
  @@map("project_category_fees")
}

/// Phase 7 — AI-assisted draft transaction.
///
/// Lifecycle:
///   1. Engineer records voice / photographs receipt → upload endpoint stores the
///      media on S3 (or local fallback) so user can replay/re-view it.
///   2. AI extracts structured data → rawExtraction.
///   3. Matching service resolves vendor/project/material/category against the
///      tenant's existing records → matchedDraft (per-field { value, candidateId,
///      confidence } shape). User reviews + edits in the UI.
///   4. On commit, a real Transaction row is created and committedTransactionId
///      is set; the draft is kept for audit but no longer surfaces in the queue.
///   5. On discard, status flips and the draft drops out of the queue.
///
/// Multi-tenant: filter by tenantId in every query, like every other resource.
/// Source media URL is preserved until the draft is hard-deleted by an admin.
model TransactionDraft {
  id                     String                @id @default(uuid())
  tenantId               String
  createdById            String
  source                 DraftSource
  status                 DraftStatus           @default(PENDING_REVIEW)

  // Original media so the user can review their input before committing
  originalMediaUrl       String?               // S3 URL or local path
  originalMediaMime      String?
  transcript             String?               // raw Whisper text (voice only)

  // What the AI returned, untouched
  rawExtraction          Json
  // After DB matching: { type, amount, ..., vendorMatch:{ name, supplierId?, confidence }, ... }
  matchedDraft           Json
  // Overall extraction confidence reported by the AI (high|medium|low)
  confidence             String?

  // Set when promoted to a real Transaction
  committedTransactionId String?               @unique
  committedTransaction   Transaction?          @relation(fields: [committedTransactionId], references: [id], onDelete: SetNull)
  committedAt            DateTime?
  discardedAt            DateTime?

  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy              User                  @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([createdById, status])
  @@map("transaction_drafts")
}

enum DraftSource {
  VOICE
  RECEIPT
}

enum DraftStatus {
  PENDING_REVIEW
  COMMITTED
  DISCARDED
}

/// Phase 6.3 — Bank reconciliation.
///
/// One BankStatement row per CSV upload. Each statement parses into
/// BankStatementRow rows; each row is auto-matched against unreconciled
/// Transactions in the tenant by amount + date proximity, then reviewed
/// + confirmed by the user. Confirming sets:
///   row.matchedTransactionId
///   row.status = MATCHED
///   transaction.reconciledAt
model BankStatement {
  id              String                  @id @default(uuid())
  tenantId        String
  uploadedById    String
  originalName    String
  status          BankStatementStatus     @default(PENDING)
  totalRows       Int                     @default(0)
  matchedRows     Int                     @default(0)
  ignoredRows     Int                     @default(0)
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy      User                    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  rows            BankStatementRow[]

  @@index([tenantId, status])
  @@map("bank_statements")
}

model BankStatementRow {
  id                     String                @id @default(uuid())
  statementId            String
  tenantId               String
  rowIndex               Int                   // original line number in the CSV (for ordering)
  rawDate                String?               // raw text from CSV
  parsedDate             DateTime?
  amount                 Decimal               @db.Decimal(15, 2)
  // Sign convention: positive = credit (money in), negative = debit (money out).
  // Egyptian banks vary; the parser normalizes Debit → -, Credit → +.
  description            String?
  reference              String?
  status                 BankStatementRowStatus @default(UNMATCHED)
  matchedTransactionId   String?               @unique
  matchedAt              DateTime?
  // Cached top-N suggestion list as Json: [{ transactionId, score, reason }]
  suggestions            Json?

  statement              BankStatement         @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedTransaction     Transaction?          @relation(fields: [matchedTransactionId], references: [id], onDelete: SetNull)

  @@index([statementId, status])
  @@index([tenantId, status])
  @@map("bank_statement_rows")
}

enum BankStatementStatus {
  PENDING       // just uploaded, suggestions not yet generated
  REVIEWING     // suggestions generated, awaiting user confirmation
  COMPLETED     // all rows either matched or ignored
  CANCELLED
}

enum BankStatementRowStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  IGNORED
}

/// Phase 6.4 — Subscription billing.
///
/// One Subscription row per tenant per period. New tenants start with a
/// FREE_PILOT subscription auto-created at register-company time. Upgrades
/// flow through Paymob: user clicks "Subscribe to BASIC", we create a
/// PaymentAttempt + redirect to a Paymob iframe; on successful HMAC-verified
/// webhook callback, the previous active sub is closed and a new one starts
/// with status=ACTIVE + currentPeriodEnd = now + 30 days.
///
/// No auto-renewal in v1 — when currentPeriodEnd passes, status flips to
/// EXPIRED via a daily cron (not yet shipped) or on next API call.
/// Renewal is a manual re-checkout for now.
model Subscription {
  id                  String              @id @default(uuid())
  tenantId            String
  plan                String              // matches a key in lib/plans.js — flexible vs an enum because plan catalog evolves
  status              SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart  DateTime            @default(now())
  currentPeriodEnd    DateTime
  amountEgp           Decimal             @db.Decimal(10, 2)
  // Paymob references for support / refunds
  paymobOrderId       String?
  paymobTransactionId String?
  // Set when admin manually cancels OR when the period ends without renewal
  cancelledAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentAttempts     PaymentAttempt[]

  @@index([tenantId, status])
  @@map("subscriptions")
}

/// Phase 6.4 — Audit trail of every checkout attempt, including failures.
/// We need this to debug "I paid but my account didn't upgrade" — common
/// on Egyptian payment flows where Fawry receipts can take minutes to
/// reconcile.
model PaymentAttempt {
  id                  String                @id @default(uuid())
  tenantId            String
  subscriptionId      String?
  plan                String
  amountEgp           Decimal               @db.Decimal(10, 2)
  status              PaymentAttemptStatus  @default(PENDING)
  // Paymob references
  paymobOrderId       String?
  paymobPaymentKey    String?
  paymobTransactionId String?
  paymobIframeUrl     String?
  failureReason       String?
  // Raw webhook payload for forensics — tenantless when fingerprint matches but we can't find the tenant
  rawWebhook          Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription        Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([paymobOrderId])
  @@map("payment_attempts")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE      // payment failed but period not yet expired
  CANCELLED     // admin or user cancelled
  EXPIRED       // period ended without renewal
}

enum PaymentAttemptStatus {
  PENDING       // checkout created, waiting for Paymob
  SUCCESS       // webhook confirmed
  FAILED        // webhook reported failure
  EXPIRED       // user never completed checkout, abandoned
}
