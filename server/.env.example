PORT=5000
NODE_ENV=development

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/civil_finance

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# File Upload (local-disk fallback when S3 not configured)
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# AWS S3 (image uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Email (SMTP — Gmail). Both required; no defaults in source.
# Generate an app-password at: https://myaccount.google.com/apppasswords
SMTP_EMAIL=
SMTP_PASSWORD=

# OpenAI (chat assistant + voice transcription)
OPENAI_API_KEY=

# CORS
CLIENT_URL=http://localhost:5173

# Comma-separated list of allowed origins (only enforced when NODE_ENV=production)
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Sentry error monitoring — leave empty to disable (the SDK no-ops if unset)
SENTRY_DSN=

# Phase 6.4 — Paymob subscription billing. All four required for paid plans
# to work. Get them from the Paymob dashboard (https://accept.paymob.com/portal2):
#   API_KEY        → Profile → API Key (long base64-ish string)
#   INTEGRATION_ID → Developers → Payment Integrations (one per method: card / wallet / Fawry)
#   IFRAME_ID      → Developers → Iframes (the widget you embed)
#   HMAC_SECRET    → Profile → HMAC (used to verify webhook callbacks)
# When unset, the server runs in "billing disabled" mode — free plan only,
# /api/billing/checkout returns 503.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Optional: cap the global AI extraction budget regardless of plan tier
# (use as an emergency circuit breaker). Plan-based caps in lib/plans.js
# apply otherwise.
AI_MONTHLY_CAP=
